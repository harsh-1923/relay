# Credential tier. The ONLY app that holds provider credentials.
#
# set-me      you must supply this; `pnpm health` fails until you do
# generate-me `pnpm run up secrets` fills it with a random local value
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

WORKOS_API_URL=https://api.workos.com
WORKOS_API_KEY=set-me
WORKOS_CLIENT_ID=set-me

# Second factor for runtime -> broker. The per-run session token is the first.
BROKER_SERVICE_KEY=generate-me
# Signs pending actions so an approval card provably carries the payload that runs.
BROKER_ACTION_SIGNING_KEY=generate-me

R2_ENDPOINT=http://localhost:8788
R2_ACCESS_KEY_ID=generate-me
R2_SECRET_ACCESS_KEY=generate-me
