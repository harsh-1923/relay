# Edge tier. Holds the session key only — no provider credentials.
#
# set-me      you must supply this; `pnpm health` fails until you do
# generate-me `pnpm run up secrets` fills it with a random local value
NODE_ENV=development
# The database PowerSync replicates — reads and writes must be the same one.
#
# Use the **session pooler** host (IPv4), not the direct `db.<ref>.supabase.co` one: newer
# Supabase projects resolve that over IPv6 only, and workerd inside `wrangler dev` has no IPv6
# route, so every query fails with "Network connection lost". The pooler cannot carry logical
# replication, which is why PowerSync itself is configured against the direct host instead —
# see tooling/powersync/service.yaml. Same database, two routes, chosen by what each needs.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# PowerSync. The instance URL is also the JWT audience — a token minted for one instance is
# rejected by another, so these two must name the same thing.
#
# HS256 and a shared secret is the development path only. Production signs asymmetrically
# (RS256/EdDSA/ES256) against a JWKS endpoint, because a symmetric secret must exist on both
# sides — see apps/server/src/powersync/token.ts.
POWERSYNC_URL=set-me
POWERSYNC_JWT_SECRET=generate-me

# From the WorkOS dashboard, in an environment that never serves production traffic.
WORKOS_API_URL=https://api.workos.com
WORKOS_API_KEY=set-me
WORKOS_CLIENT_ID=set-me
WORKOS_COOKIE_PASSWORD=generate-me
# Dashboard → Webhooks. WorkOS cannot reach localhost, so end-to-end testing needs a tunnel;
# the handler itself is covered by tests.
WORKOS_WEBHOOK_SECRET=set-me
