# Untrusted-content tier. Invariant 6.
#
# This file must never gain a provider token, a database URL, or an object-storage key.
# If you are about to add one, the work belongs in apps/broker and reaches this process
# as a tool result instead. A credential here is a design regression, not a shortcut.
#
# BROKER_SERVICE_KEY is not an exception: it is a service factor, not a provider
# credential, and it is useless without the per-run session token minted at dispatch.
NODE_ENV=development
BROKER_URL=http://localhost:8788
BROKER_SERVICE_KEY=generate-me
PI_MODEL_BASE_URL=http://localhost:11434/v1
